NODE_ENV=production
PORT=3001
SERVER_MODE=local

# SQLite database path (relative to server/ dir)
SQLITE_PATH=./data/printeasy.db

# Online server to sync outbox to
ONLINE_SERVER_URL=https://yourapp.com/api
ONLINE_SYNC_SECRET=a_random_secret_shared_with_online_server

# Shop identity — set once during shop onboarding
SHOP_ID=1
SHOP_UUID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# QR token TTL in minutes
QR_TOKEN_TTL_MINUTES=10

# Local IP broadcast in QR codes
LOCAL_IP=192.168.x.x
